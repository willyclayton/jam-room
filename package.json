    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "partykit": "^0.0.115",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
